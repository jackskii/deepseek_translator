# ============================================================
# General settings
# ============================================================
# Which provider to use: "deepseek" or "openrouter"
LLM_PROVIDER="deepseek"

# ============================================================
# DeepSeek (https://platform.deepseek.com)
# ============================================================
DEEPSEEK_API_KEY="your_deepseek_key_here"
# Model to use. "deepseek-v4-pro" is the newest current model and supports
# REASONING_EFFORT (none / low / high / max). "deepseek-reasoner" (R1) is a
# legacy thinking model with reasoning always on; it ignores REASONING_EFFORT.
DEEPSEEK_MODEL="deepseek-v4-pro"
# Reasoning effort for current models: none / low / high / max.
# Ignored by deepseek-reasoner. Default: low.
REASONING_EFFORT="low"

# ============================================================
# OpenRouter (https://openrouter.ai)
# ============================================================
OPENROUTER_API_KEY="your_openrouter_key_here"
# Model slug, e.g. "deepseek/deepseek-r1", "deepseek/deepseek-chat",
# "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet", etc.
OPENROUTER_MODEL="deepseek/deepseek-r1"
